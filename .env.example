# OpenAI-compatible chat endpoint. Copy to .env (never commit it).
# The default profile reads MODEL / BASE_URL / API_KEY; --model, --base-url and --api-key-env override them.
MODEL=qwen3.6-flash
BASE_URL=https://your-openai-compatible-endpoint/v1
API_KEY=replace-me

# Named profiles: `--provider NAME` reads NAME_MODEL / NAME_BASE_URL / NAME_API_KEY
# (minimax and deepseek have built-in model and base URL defaults, see hexis/llm/env.py).
# MINIMAX_API_KEY=
# DEEPSEEK_API_KEY=
