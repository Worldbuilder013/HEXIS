# OpenAI-compatible chat endpoint. Copy to .env (never commit it).
# `--provider default` reads MODEL / BASE_URL / API_KEY; the experiments used qwen3.6-flash.
MODEL=qwen3.6-flash
BASE_URL=https://your-openai-compatible-endpoint/v1
API_KEY=replace-me

# Named profiles: `--provider minimax` or `--provider deepseek` read <PROFILE>_API_KEY and,
# optionally, <PROFILE>_MODEL / <PROFILE>_BASE_URL (defaults in skill2fsm/env.py).
# MINIMAX_API_KEY=
# DEEPSEEK_API_KEY=
