{
  "backend": "opencode",
  "description": "OpenCode native tools. The collector wraps every tool result as ok / returncode / stdout / stderr.",
  "tools": {
    "bash": {
      "description": "Run one shell command in the working directory.",
      "input_schema": {"command": {"type": "string", "required": true},
                       "description": {"type": "string", "constant": true},
                       "timeout": {"type": "integer", "constant": true}},
      "output_schema": {"ok": "boolean", "returncode": "integer", "stdout": "string", "stderr": "string"},
      "success": "returncode == 0", "primary": "stdout"
    },
    "read": {
      "description": "Read the text content of a file.",
      "input_schema": {"filePath": {"type": "string", "required": true},
                       "offset": {"type": "integer", "constant": true},
                       "limit": {"type": "integer", "constant": true}},
      "output_schema": {"ok": "boolean", "returncode": "integer", "stdout": "string", "stderr": "string"},
      "success": "returncode == 0", "primary": "stdout", "label": "probe"
    },
    "write": {
      "description": "Write text to a file (overwriting it).",
      "input_schema": {"filePath": {"type": "string", "required": true},
                       "content": {"type": "string", "required": true}},
      "output_schema": {"ok": "boolean", "returncode": "integer", "stdout": "string", "stderr": "string"},
      "success": "returncode == 0", "primary": "stdout", "label": "apply"
    },
    "edit": {
      "description": "Replace one piece of text in a file with another.",
      "input_schema": {"filePath": {"type": "string", "required": true},
                       "oldString": {"type": "string", "required": true},
                       "newString": {"type": "string", "required": true},
                       "replaceAll": {"type": "boolean", "constant": true}},
      "output_schema": {"ok": "boolean", "returncode": "integer", "stdout": "string", "stderr": "string"},
      "success": "returncode == 0", "primary": "stdout", "label": "apply"
    },
    "list": {
      "description": "List a directory.",
      "input_schema": {"path": {"type": "string"}, "ignore": {"type": "array", "constant": true}},
      "output_schema": {"ok": "boolean", "returncode": "integer", "stdout": "string", "stderr": "string"},
      "success": "returncode == 0", "primary": "stdout", "label": "probe"
    },
    "glob": {
      "description": "Find files by glob pattern.",
      "input_schema": {"pattern": {"type": "string", "required": true}, "path": {"type": "string"}},
      "output_schema": {"ok": "boolean", "returncode": "integer", "stdout": "string", "stderr": "string"},
      "success": "returncode == 0", "primary": "stdout", "label": "probe"
    },
    "grep": {
      "description": "Search for text in files.",
      "input_schema": {"pattern": {"type": "string", "required": true}, "path": {"type": "string"},
                       "include": {"type": "string", "constant": true}},
      "output_schema": {"ok": "boolean", "returncode": "integer", "stdout": "string", "stderr": "string"},
      "success": "returncode == 0", "primary": "stdout", "label": "probe"
    }
  }
}
